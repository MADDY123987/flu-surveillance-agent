# CockroachDB connection string (from CockroachDB Cloud Console -> Connect).
# Requires the `sqlalchemy-cockroachdb` package (see requirements.txt) for the
# `cockroachdb` dialect, and the `+psycopg` driver suffix to use psycopg3
# (plain `psycopg2` is not installed - see requirements.txt). Cloud Console gives you
# a `postgresql://` string by default - change the scheme to `cockroachdb+psycopg://`:
# cockroachdb+psycopg://<user>:<password>@<host>:26257/<database>?sslmode=verify-full
DATABASE_URL=

# AWS region where Bedrock model access is enabled
AWS_REGION=us-east-1

# Bedrock model IDs (defaults match app/config.py if left unset)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_REASONING_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS credentials (only needed if not using an IAM role / instance profile / SSO session).
# boto3 will also pick these up from ~/.aws/credentials or environment automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Comma-separated list of regions to ingest/monitor (locked scope: US National + 3 states)
TARGET_REGIONS=US,California,Texas,New York

# Signal type ingested from the Delphi/ILINet source
TARGET_SIGNAL=flu_like_illness

# Set to true to mock Bedrock calls (embedding + reasoning) for local development
# without AWS credentials. Leave false/unset for real deployments and the demo
# recording - mock embeddings carry no real semantic meaning (see app/agent.py).
MOCK_BEDROCK=false
